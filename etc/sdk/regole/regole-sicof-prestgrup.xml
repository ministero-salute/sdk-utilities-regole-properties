	<!--MULTIRECORD-->
	<regolemultirecord>
		<regola codiceErrore="S.3.30.004.003" descrizioneErrore="Chiave del record presente nel medesimo invio (chiave duplicata)">
			<query><![CDATA[select * from {{table}} orig 
					join ( select id_iniz, id_inc, reg_erog, asl_erog, cc_erog, data_inc from {{table}}
				    group by id_iniz, id_inc, reg_erog, asl_erog, cc_erog, data_inc having count(1) > 1 
					) reject 
					on (orig.reg_erog = reject.reg_erog and orig.id_iniz = reject.id_iniz and orig.id_inc= reject.id_inc and orig.asl_erog = reject.asl_erog and orig.cc_erog = reject.cc_erog and orig.data_inc = reject.data_inc )]]>
			</query>
		</regola>
	</regolemultirecord>

