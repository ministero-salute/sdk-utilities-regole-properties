    <regolemultirecord>
        <regola codiceErrore="S.3.30.002.002" descrizioneErrore="Chiave del record presente nel medesimo invio (chiave duplicata)">
            <query><![CDATA[select * from {{table}} orig
             join ( select anno_erog, reg_erog, as_erog, strut_erog from {{table}} group by anno_erog, reg_erog, as_erog, strut_erog having count(1) > 1 ) reject
             on (orig.anno_erog = reject.anno_erog and orig.reg_erog = reject.reg_erog and orig.as_erog = reject.as_erog and orig.strut_erog = reject.strut_erog )]]></query>
        </regola>
    </regolemultirecord>

